  "cards": [
    {
      "dot": "cyan",
      "title": "Exact package",
      "items": [
        "public/index.html + RELEASE.json + MANIFEST.sha256",
        "Manifest hashes page + release metadata; never itself.",
        "Deterministic tar/gzip; outputs outside clean checkout."
      ]
    },
    {
      "dot": "rose",
      "title": "Why the inner check matters",
      "items": [
        "Demo replaces page and re-pins outer SHA in evidence + expectation.",
        "Original manifest stays: per-file checking rejects substituted bytes.",
        "Disabling that comparison admits the corrupt fixture (sensitivity test)."
      ]
    },
    {
      "dot": "amber",
      "title": "Trust and scope limits",
      "items": [
        "Expected inputs need an independent trusted path outside this sample.",
        "Control every expectation and agreement can be forged.",
        "Supplied CI context is not authenticated CI. No activation or rollback."
      ]
    }
  ]
